# ---------------------------------------------------------------------------
# Malawi Airlines Roster Builder — files that must never be committed.
# Nested .gitignore files in storage/, bootstrap/cache/ and database/ also
# exclude runtime caches, logs, sessions and SQLite databases.
# ---------------------------------------------------------------------------

# Design references and raw artwork (kept locally, not part of the app).
# The served logo lives in public/images/malawi-airlines-logo.png.
/uibuilder
/logo

# Dependencies (restored by composer install / npm ci)
/vendor
/node_modules

# Environment and secrets (only .env.example is committed)
.env
.env.*
!.env.example
/auth.json
/storage/*.key
*.pem
*.key
!/resources/**/*.key

# Build output and Vite dev artefacts
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/public/mix-manifest.json

# Local databases, dumps and backups
*.sqlite
*.sqlite-journal
*.sqlite3
*.sql
*.sql.gz
*.dump
*.bak

# Test, lint and analysis caches
/.phpunit.cache
.phpunit.result.cache
/coverage
/.php-cs-fixer.cache
/.php-cs-fixer.php
.phpactor.json
/.phpstan
/.pint.cache
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/storage/pail

# Local tooling and personal editor/agent settings
/.idea
/.vscode
/.fleet
/.nova
/.zed
/.windsurf
/.codex
/.cursor/
/.claude/settings.local.json
Homestead.json
Homestead.yaml

# Operating system and editor clutter
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
