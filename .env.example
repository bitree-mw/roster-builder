APP_NAME="Malawi Airlines Roster Builder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://roster-builder.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------------------------------
# Email (roster emails to crew and password reset links) — cPanel mailbox placeholders.
# 1. In cPanel → Email Accounts, create a mailbox, e.g. roster@your-domain.com.
# 2. Its "Connect Devices" page shows the outgoing (SMTP) server and port: copy them below.
#    SSL/TLS (recommended): MAIL_PORT=465 with MAIL_SCHEME=smtps
#    STARTTLS:              MAIL_PORT=587 with MAIL_SCHEME=smtp
# 3. MAIL_USERNAME is the full mailbox address; MAIL_FROM_ADDRESS should be the same address
#    (most cPanel hosts reject mail "from" another address).
# For local development without sending, use MAIL_MAILER=log (emails are written to storage/logs).
# Check the settings with: php artisan roster:doctor, then confirm delivery by requesting a password
# reset for your own account ("Forgot password?" on the sign-in page).
# ---------------------------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=roster@your-domain.com
MAIL_PASSWORD="your-mailbox-password"
MAIL_FROM_ADDRESS="roster@your-domain.com"
MAIL_FROM_NAME="Malawi Airlines Crew Control"
# Optional: the host name the server greets with (defaults to the APP_URL host).
MAIL_EHLO_DOMAIN=

# Roster emails are queued (password reset links are sent straight away). cPanel has no always-on
# worker, so add a cron job (cPanel → Cron Jobs, every minute) that sends what is waiting:
#   /usr/local/bin/php /home/CPANEL_USER/path-to-app/artisan queue:work --stop-when-empty >/dev/null 2>&1
# Or set QUEUE_CONNECTION=sync to send while the scheduler waits (slower for many crew).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Extra hosts whose browser sessions may call /api/v1. The app's own host and APP_URL are always
# accepted, so this is normally left empty (it adds to the defaults, it never replaces them).
SANCTUM_STATEFUL_DOMAINS=

# Hosted (production) settings — check them with: php artisan roster:doctor
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-roster-domain.example
#   SESSION_SECURE_COOKIE=true          (only when the site uses https)
#   SESSION_DOMAIN=null                 (or exactly your domain; a wrong value drops the sign-in cookie)
#   TRUSTED_PROXIES=*                   (when https is handled by a load balancer, Cloudflare or a hosting proxy)
#   MAIL_* settings                     (see the cPanel email section above)
#   Queue cron job for roster emails    (see the email section above)
TRUSTED_PROXIES=
DEMO_EMAIL=
DEMO_PASSWORD=

# Include exception details in API 500 responses (only ever applies when APP_DEBUG=true)
API_EXPOSE_DEBUG=true

# Signature at the end of roster emails to crew (config/roster.php).
ROSTER_MAIL_SIGNATURE="Crew Control, Malawi Airlines"

# Print the airline logo on PDF documents (confirm usage rights before distributing PDFs externally).
ROSTER_PDF_LOGO=true

# Longest flight rotation in days, including night stops (the same crew stay with it until back at base).
ROSTER_MAX_TRIP_DAYS=14

# Seconds a roster build may run (monthly rosters take longer; many shared hosts stop requests at 30 seconds).
ROSTER_BUILD_TIME_LIMIT=180

# Show the airline logo in roster emails (defaults to ROSTER_PDF_LOGO).
ROSTER_MAIL_LOGO=true
